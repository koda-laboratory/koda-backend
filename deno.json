{
  "tasks": {
    "check": "deno check supabase/functions/*/index.ts tests/functions/*.ts scripts/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-env --allow-read tests"
  },
  "lint": {
    "include": ["supabase/functions", "tests", "scripts"],
    "rules": { "tags": ["recommended"] }
  },
  "fmt": {
    "include": ["supabase/functions", "tests", "scripts"],
    "lineWidth": 120
  }
}
