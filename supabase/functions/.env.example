# Copy to supabase/functions/.env (ignored) and run:
#   supabase functions serve --env-file supabase/functions/.env
# Hosted values are set with `supabase secrets set` (see README.md). Never commit real values.

# Internal shared secrets (long random strings). The same values go into Vault (see README.md).
PUSH_INTERNAL_SECRET=change-me
KEEPALIVE_SECRET=change-me

# APNs token auth. Leave APNS_PRIVATE_KEY empty locally: the push function then skips sending.
APNS_KEY_ID=38H2AWSNST
APNS_TEAM_ID=MUDCX7X324
APNS_BUNDLE_ID=com.kodalabs.app
# PKCS#8 PEM content of the .p8 file. Set it from the file; never paste it into tracked files.
APNS_PRIVATE_KEY=
